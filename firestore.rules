rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ========= HELPERS ========= */
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFriendOf(authorId, dbVar) {
      return isSignedIn() && (
        exists(/databases/$(dbVar)/documents/Friendships/$(request.auth.uid + '_' + authorId))
        || exists(/databases/$(dbVar)/documents/Friendships/$(authorId + '_' + request.auth.uid))
      );
    }

    /* ========= USERS ========= */
    // Public profiles / Find Friends / search: guest + user đều đọc được
    // Ghi (create/update/delete): chỉ chủ tài khoản
    // Chứa trường `hasPassword` (boolean) để theo dõi nếu người dùng đã đặt mật khẩu
    // (nhằm hiển thị giao diện Tạo Mật Khẩu (cho Google) hoặc Đổi Mật Khẩu (yêu cầu mật khẩu cũ)).
    match /Users/{userId} {
      allow read: if true;

      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /* ========= FOLLOWS ========= */
    // Public follower counts; follow/unfollow only by the follower (fromUserId)
    // documentId = "fromUid_toUid"
    match /Follows/{followId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.keys().hasAll(['fromUserId', 'toUserId', 'createdAt'])
        && followId == request.auth.uid + '_' + request.resource.data.toUserId;

      allow update: if false;

      allow delete: if isSignedIn()
        && resource.data.fromUserId == request.auth.uid;
    }

    /* ========= FRIEND REQUESTS ========= */
    match /FriendRequests/{requestId} {
      // Tạo lời mời kết bạn
      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid;

      // Chỉ 2 người trong request được xem
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);

      // Cập nhật status (accept / reject / cancel): cả sender & receiver
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.toUserId
            || request.auth.uid == resource.data.fromUserId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']);

      // Huỷ / xoá lời mời: cả 2 bên đều được
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
    }

    /* ========= FRIENDSHIPS (BẠN BÈ) ========= */
    // documentId = "uidA_uidB" (2 uid đã sort sẵn)
    // fields: participants: [uidA, uidB], status: "accepted", createdAt, updatedAt
    match /Friendships/{chatId} {
      // helper dùng resource (đã tồn tại)
      function isFriendshipParticipant() {
        return isSignedIn()
          && (request.auth.uid in resource.data.participants);
      }

      // Đọc / sửa / xoá: chỉ 2 người trong mối quan hệ này
      allow read, update, delete: if isFriendshipParticipant();

      // Tạo doc friendship sau khi accept friend-request
      // dùng request.resource (vì create chưa có resource)
      allow create: if isSignedIn()
        && (request.auth.uid in request.resource.data.participants)
        && request.resource.data.participants.size() == 2
        && request.resource.data.status == 'accepted';
    }

    /* ========= GLOBAL POSTS ========= */
    match /Posts/{postId} {
      function hasValidVisibility(data) {
        return !data.keys().hasAny(['status'])
          || data.status in ['public', 'friends', 'private'];
      }

      function hasValidFriendTags(data) {
        return !data.keys().hasAny(['taggedFriendIds', 'taggedFriends'])
          || (
            data.keys().hasAll(['taggedFriendIds', 'taggedFriends'])
            && data.taggedFriendIds is list
            && data.taggedFriends is list
            && data.taggedFriendIds.size() == data.taggedFriends.size()
            && data.taggedFriendIds.size() <= 20
            && !(request.auth.uid in data.taggedFriendIds)
          );
      }

      function isValidReactionUpdate() {
        let oldLikes = resource.data.likes;
        let newLikes = request.resource.data.likes;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reactedBy'])
          && request.resource.data.reactedBy.diff(resource.data.reactedBy).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.reactedBy.get(request.auth.uid, null) in [null, 'Like', 'Love', 'Haha', 'Wow', 'Sad', 'Angry']
          && newLikes.diff(oldLikes).affectedKeys().hasOnly(['Like', 'Love', 'Haha', 'Wow', 'Sad', 'Angry'])
          && newLikes.get('Like', 0) >= 0
          && newLikes.get('Love', 0) >= 0
          && newLikes.get('Haha', 0) >= 0
          && newLikes.get('Wow', 0) >= 0
          && newLikes.get('Sad', 0) >= 0
          && newLikes.get('Angry', 0) >= 0;
      }

      allow get: if !resource.data.keys().hasAny(['status'])
        || resource.data.status == 'public'
        || (isSignedIn() && request.auth.uid == resource.data.userId)
        || (resource.data.status == 'friends' && isFriendOf(resource.data.userId, database));

      allow list: if true;

      // Chỉ user đăng nhập mới tạo được post
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'createdAt'])
        && hasValidVisibility(request.resource.data)
        && hasValidFriendTags(request.resource.data)
        && (!request.resource.data.keys().hasAny(['type'])
            || request.resource.data.type in ['post', 'share'])
        && (!request.resource.data.keys().hasAny(['type'])
            || request.resource.data.type != 'post'
            || (request.resource.data.title is string
                && request.resource.data.title.size() > 0
                && request.resource.data.title.size() <= 180))
        && (!request.resource.data.keys().hasAny(['type'])
            || request.resource.data.type != 'share'
            || request.resource.data.keys().hasAny(['sharedPostId', 'sharedFrom']));

      // Update:
      // - Chủ post: title, content, mediaUrls, status
      // - Người khác: chỉ reactions
      allow update: if isSignedIn() && (
        (request.auth.uid == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'title',
              'content',
              'contentHtml',
              'contentText',
              'searchText',
              'mediaUrls',
              'mediaFiles',
              'status',
              'taggedFriendIds',
              'taggedFriends',
              'updatedAt'
            ])
          && hasValidVisibility(request.resource.data)
          && hasValidFriendTags(request.resource.data)
        )
        || isValidReactionUpdate()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saveCount'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount'])
      );

      // Xóa: chỉ chủ post
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;

      /* ----- Comments ----- */
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;

        allow update: if isSignedIn() && (
          request.auth.uid == resource.data.userId ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'reactionCount', 'replyCount'])
        );

        allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.userId
              || request.auth.uid == get(/databases/$(database)/documents/Posts/$(postId)).data.userId);

        /* ----- Replies (lồng nhau) ----- */
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isSignedIn()
            && request.resource.data.userId == request.auth.uid;
          allow update: if isSignedIn() && (
            request.auth.uid == resource.data.userId ||
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reactions', 'reactionCount', 'replyCount'])
          );
          allow delete: if isSignedIn()
            && (request.auth.uid == resource.data.userId
                || request.auth.uid == get(/databases/$(database)/documents/Posts/$(postId)).data.userId);

          // Cho phép nesting không giới hạn
          match /{document=**} {
            allow read: if true;
            allow create: if isSignedIn()
              && request.resource.data.userId == request.auth.uid;
            allow update: if isSignedIn() && (
              request.auth.uid == resource.data.userId ||
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions', 'reactionCount', 'replyCount'])
            );
            allow delete: if isSignedIn()
              && request.auth.uid == resource.data.userId;
          }
        }

        // Comment reactions
        match /reactions/{userId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    /* ========= SAVED POSTS ========= */
    // documentId = "uid_postId". Bookmark là dữ liệu riêng của từng user.
    match /SavedPosts/{savedPostId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'postId', 'savedAt'])
        && request.resource.data.keys().hasOnly(['userId', 'postId', 'savedAt'])
        && savedPostId == request.auth.uid + '_' + request.resource.data.postId
        && exists(/databases/$(database)/documents/Posts/$(request.resource.data.postId));
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /* ========= FAVORITE BLOGS ========= */
    match /FavoriteBlogs/{favoriteId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && favoriteId == request.auth.uid + '_' + request.resource.data.blogId
        && (
          exists(/databases/$(database)/documents/BlogPosts/$(request.resource.data.blogId))
          || request.resource.data.blogId.matches('^static-.*')
        );
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    /* ========= PRIVATE MESSAGES ========= */
    // Collection: Messages/{chatId}/messages/{messageId}
    // chatId = "uidA_uidB" (2 uid đã sort)
    match /Messages/{chatId} {

      function isParticipant() {
        return isSignedIn()
          && (request.auth.uid in chatId.split('_'));
      }

      // Đã là bạn bè?
      function isFriend() {
        return isParticipant()
          && exists(/databases/$(database)/documents/Friendships/$(chatId))
          && get(/databases/$(database)/documents/Friendships/$(chatId)).data.status == 'accepted';
      }

      // Chỉ bạn bè mới thấy conversation
      allow read: if isFriend();
      
      // Cho phép tạo/cập nhật cấu hình cuộc trò chuyện (theme, nicknames, quickEmoji, blockedBy, mutedBy)
      allow create, update: if isFriend();
      allow delete: if false;

      match /messages/{messageId} {
        // Chỉ bạn bè mới đọc được tin nhắn
        allow read: if isFriend();

        // Gửi tin nhắn:
        // - đã là bạn
        // - auth.uid là sender
        // - receiver nằm trong chatId
        // - cuộc trò chuyện không bị chặn (blockedBy trống)
        allow create: if isFriend()
          && request.auth.uid == request.resource.data.senderId
          && request.resource.data.receiverId in chatId.split('_')
          && (
            !exists(/databases/$(database)/documents/Messages/$(chatId))
            || !('blockedBy' in get(/databases/$(database)/documents/Messages/$(chatId)).data)
            || get(/databases/$(database)/documents/Messages/$(chatId)).data.blockedBy.size() == 0
          );

        // Cập nhật tin nhắn:
        // - Người gửi (sender) được phép thay đổi mọi thứ (chỉnh sửa, thu hồi, v.v.)
        // - Người nhận (receiver) được phép cập nhật danh sách cảm xúc (reactions) hoặc đã xem (readBy)
        allow update: if isFriend() && (
          request.auth.uid == resource.data.senderId
          || (
            request.auth.uid == resource.data.receiverId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy'])
          )
        );

        // Xoá tin nhắn: chỉ người gửi được phép
        allow delete: if isFriend()
          && request.auth.uid == resource.data.senderId;
      }
    }

    /* ========= COLLECTION GROUP: MESSAGES ========= */
    match /{path=**}/messages/{messageId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.receiverId
            || request.auth.uid == resource.data.senderId);
    }

    /* ========= NOTIFICATIONS ========= */
    match /Notifications/{notificationId} {
      // Chỉ chủ notification được đọc
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Actor (logged-in) có thể tạo notification cho người khác (like, friend request…)
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['userId'])
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0;

      // Chủ notification tự update (đã đọc) / xoá
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    /* ========= PRODUCTS (store) ========= */
    match /Products/{productId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.sellerId == request.auth.uid;
    }

    /* ========= ORDERS ========= */
    match /Orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);
      allow delete: if false;
    }

    /* ========= REVIEWS ========= */
    match /Reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    /* ========= CARTS ========= */
    match /Carts/{userId} {
      allow read, write: if isOwner(userId);
    }
    /* ========= GROUPS ========= */
    match /Groups/{groupId} {
      function isGroupMember() {
        // giả sử Group có field members: array<string>
        return isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/Groups/$(groupId)).data.members);
      }

      allow read: if true;
      allow create: if isSignedIn();

      // Chủ group sửa mọi thứ, member khác chỉ có thể update members
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
      );

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId;

      // Group posts
      match /Posts/{postId} {
        // Public browse: guest + user xem post nhóm (join/create vẫn gated ở app + isGroupMember)
        // (app hiện không set isPublic; không khóa đọc theo field đó)
        allow read: if true;

        // Chỉ member mới post
        allow create: if isGroupMember()
          && request.resource.data.userId == request.auth.uid;

        allow update: if isGroupMember() && (
          (request.auth.uid == resource.data.userId &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'title',
                'content',
                'contentHtml',
                'contentText',
                'searchText',
                'mediaUrls',
                'mediaFiles',
                'status',
                'updatedAt',
                'likes',
                'reactedBy',
                'reactions',
                'reactionCount'
              ])
          )
          ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'reactedBy', 'reactions', 'reactionCount'])
        );

        allow delete: if isGroupMember()
          && request.auth.uid == resource.data.userId;

        // Comments trong group post
        match /comments/{commentId} {
          allow read: if true; // hoặc isGroupMember() nếu muốn kín hoàn toàn
          allow create: if isGroupMember()
            && request.resource.data.userId == request.auth.uid;

          allow update: if isGroupMember() && (
            request.auth.uid == resource.data.userId ||
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reactions', 'reactionCount', 'replyCount'])
          );

          allow delete: if isGroupMember()
            && request.auth.uid == resource.data.userId;

          // Replies
          match /replies/{replyId} {
            allow read: if true; // hoặc isGroupMember()
            allow create: if isGroupMember()
              && request.resource.data.userId == request.auth.uid;

            allow update: if isGroupMember() && (
              request.auth.uid == resource.data.userId ||
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions', 'reactionCount', 'replyCount'])
            );

            allow delete: if isGroupMember()
              && request.auth.uid == resource.data.userId;

            // Unlimited nesting
            match /{document=**} {
              allow read: if true; // hoặc isGroupMember()
              allow create: if isGroupMember()
                && request.resource.data.userId == request.auth.uid;

              allow update: if isGroupMember() && (
                request.auth.uid == resource.data.userId ||
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['reactions', 'reactionCount', 'replyCount'])
              );

              allow delete: if isGroupMember()
                && request.auth.uid == resource.data.userId;
            }
          }

          // Comment reactions
          match /reactions/{userId} {
            allow read: if true;
            allow write: if isGroupMember();
          }
        }
      }

      /* ========= GROUP SUBCOLLECTIONS (supplement) ========= */
      match /Events/{eventId} {
        function isGroupEventMember() {
          return isSignedIn()
            && (request.auth.uid in get(/databases/$(database)/documents/Groups/$(groupId)).data.members);
        }
        allow read: if true;
        allow create: if isGroupEventMember()
          && request.resource.data.groupId == groupId
          && request.resource.data.ownerId == request.auth.uid;
        allow update: if isGroupEventMember() && (
          request.auth.uid == resource.data.ownerId
        );
        allow delete: if isGroupEventMember()
          && request.auth.uid == resource.data.ownerId;
      }

      match /Media/{mediaId} {
        allow read: if true;
        allow create: if isGroupMember()
          && request.resource.data.groupId == groupId
          && request.resource.data.keys().hasAll(['groupId', 'createdAt', 'mediaUrls']);
        allow update: if isGroupMember() && request.auth.uid == resource.data.uploaderId;
        allow delete: if isGroupMember() && request.auth.uid == resource.data.uploaderId;
      }
    }

    /* ========= EVENTS ========= */
    match /Events/{eventId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'startDateTime', 'endDateTime', 'ownerId', 'attendees', 'createdAt'])
        && request.resource.data.startDateTime is string
        && request.resource.data.endDateTime is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.attendees.size() == 1
        && request.resource.data.attendees[0] == request.auth.uid;

      allow update: if isSignedIn() && (
        // Owner can update everything
        (request.auth.uid == resource.data.ownerId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'name', 'startDateTime', 'endDateTime', 'location', 'description', 'bannerImage',
              'attendees'
            ])
          && (!request.resource.data.keys().hasAny(['bannerImage'])
              || request.resource.data.bannerImage.matches('^https://.*')
              && request.resource.data.bannerImage.size() <= 500)
        )
        ||
        // Only update attendees (join/leave) — non-owners only
        (request.auth.uid != resource.data.ownerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees'])
        )
      );

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId;
    }

    /* ========= STORIES ========= */
    match /Stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mediaFiles'])
      );
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;
    }

    /* ========= GAMES ========= */
    match /Games/{gameId} {
      allow read: if true;

      // Chỉ user đăng nhập mới tạo được game
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // Update/Delete: chỉ chủ game, và không phải game mặc định
      allow update, delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId
        && !gameId.matches('^default-.*');
    }

    /* ========= BLOG ========= */
    match /BlogPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['title', 'slug', 'content', 'description', 'category', 'tags', 'createdAt', 'updatedAt', 'author'])
        && request.resource.data.published is bool
        && request.resource.data.author == request.auth.uid;
      allow update: if isSignedIn() && (
        // Author can update everything
        (request.auth.uid == resource.data.author &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'slug', 'content', 'description', 'category', 'tags', 'coverImage', 'published', 'contentText', 'searchText', 'views', 'updatedAt', 'favoriteCount'
          ])
        )
        ||
        // Non-authors can only increment/decrement favoriteCount
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount']))
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.author;
    }

    match /BlogCategories/{catId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /BlogTags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    /* ========= ONLINE USERS ========= */
    match /OnlineUsers/{sessionId} {
      allow read, write: if true;
    }

    /* ========= SYSTEM STATS ========= */
    match /SystemStats/{statsId} {
      allow read, write: if true;
    }
  }
}
